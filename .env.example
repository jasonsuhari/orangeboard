# Copy to .env.local and fill in what you need. Everything except the Mapbox
# token is optional — the app degrades to heuristics/synthetic data without it.

# Required for /map, /sightline, /vision to render the map at all
NEXT_PUBLIC_MAPBOX_TOKEN=

# Company briefs, creatives, and pedestrian vision agents (heuristic fallbacks when unset)
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_BRIEF_MODEL=
# OPENAI_VISION_MODEL=
# OPENAI_CHAT_MODEL=
# OPENAI_PED_AGENT_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_IMAGE_MODEL_LIVE=
# OPENAI_IMAGE_QUALITY_LIVE=
# OPENAI_IMAGE_ENDPOINT=

# Street View composites
GOOGLE_MAPS_API_KEY=

# Billboard detection (Grounding DINO)
NVIDIA_API_KEY=
# NVIDIA_GDINO_URL=

# Outbound workflows
ORANGESLICE_API_KEY=
FIBER_API_KEY=

# Richer SF Muni transit feed (falls back to public NextBus without it)
MUNI_511_API_KEY=

# Deploy-time only (Vercel + Convex)
# CONVEX_DEPLOY_KEY=
